# Необязательно. Без этих переменных пример работает на игрушечных эмбеддингах: без сети и без денег.
# Программа читает их из окружения; сам файл .env она не загружает.
#   Bash:       set -a; source .env; set +a
#   PowerShell: $env:YANDEX_API_KEY = "..."
# Реальные значения в репозиторий не коммитим.

# API-ключ сервисного аккаунта (роль ai.languageModels.user)
YANDEX_API_KEY=

# ID каталога в Yandex Cloud, вида b1g...
YANDEX_FOLDER_ID=
